# ESP-IDF 6.0 bootloader for tab5-os on ESP32-P4 chip v3.x (the
# ESP32-P4-Function-EV-Board v1.6.x, doc/58 R1b). The same settings as
# sdkconfig.defaults otherwise.
CONFIG_IDF_TARGET="esp32p4"
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=n
CONFIG_ESP32P4_REV_MIN_300=y

# The kernel's v3 memory map (kernel/link-esp32p4v3.ld) starts above a
# 128 KiB L2 cache.
CONFIG_CACHE_L2_CACHE_128KB=y

# Required for M/U isolation (see sdkconfig.defaults).
CONFIG_BOOTLOADER_REGION_PROTECTION_ENABLE=n

CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
